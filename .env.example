# ---- Midnight City observer (required) ----
MCITY_OBSERVER_URL=https://midnight.city/observer
MCITY_API_TOKEN=midnight_your_user_api_key
# Optional: skip the `claimable` lookup and pin the agent id
# MCITY_AGENT_ID=user-agent-...

# ---- LLM for conversations (optional; rule engine works without it) ----
# CLAUDE_API_KEY=sk-ant-...            # alias for ANTHROPIC_API_KEY
# ANTHROPIC_WORKSPACE_ID=wrkspc_...    # only for identity-linked keys
# MCITY_LLM_MODEL=claude-sonnet-5
# MCITY_LLM_DAILY_BUDGET_USD=2.50

# ---- daily rhythm (optional) ----
# MCITY_SLEEP_START=01:00
# MCITY_SLEEP_END=06:30
# MCITY_REPORT_TIME=08:00
# MCITY_STATUS_EVERY_HOURS=3
# MCITY_WEIGHTS=work:35,social:15,explore:15,quest:20,hustle:15   # a key left out keeps its default; quest:0 turns contract runs off, hustle:0 the notary sales runs
# MCITY_MAX_HUSTLES=4                  # notary sales runs per day (scripts/lib/hustle.mjs); MCITY_HUSTLE_MAX_MIN=25 minutes per run
# MCITY_HUSTLE_PITCH_GAP_S=90          # seconds between pitches; MCITY_HUSTLE_MAX_PITCHES=30 per day; MCITY_HUSTLE_REPITCH_H=48 before the same agent hears it again
# MCITY_HUSTLE_CHARGE_FIRST=1          # pitched agents pay from the first anchor (the free first one is for people who ask)
# MCITY_HUSTLE_SPOTS=central-plaza,partner-plaza,hacker-house,charging-house-lobby,bison-valley   # where to look for a crowd; MCITY_HUSTLE_MIN_CROWD=3
# MCITY_UPDATES_EVERY_MIN=180          # scan GitHub releases / npm of the ODATANO projects for news M₳X talks about (0 = off)
# MCITY_MAX_QUESTS=3                   # contract runs across all skills per day (scripts/lib/quest.mjs); MCITY_QUEST_MAX_MIN=90 time budget per run
# MCITY_QUEST_GRIND=1                  # after the contracts: gather XP at free nodes with the time left (0 = contracts only)
# MCITY_QUEST_MAX_GATHERS=40           # gathers per run (contracts + grind)
# MCITY_WORK_SWITCH_MIN=30             # work mode: after N min with fewer than MCITY_WORK_MIN_YIELD coins, spend the batch's time on other work (0 = wait at the terminal)
# MCITY_WORK_MIN_YIELD=15
# MCITY_ALTWORK_MAX_GATHERS=100        # gathers that other work may spend (contracts + grind at free nodes; does not count as a quest run)
# MCITY_QUEST_SKIP_SKILLS=bounty_hunting,combat,defence,ranged,vitality   # no fighting; MCITY_QUEST_SKIP_SOURCES=crypto_terminal (contested, work mode has it)
# MCITY_NOTARY_PRICE=10                # crystal per anchor for other agents (send-crystal); 0 = everything free
# MCITY_NOTARY_FREE_FIRST=1            # first anchor per agent stays free (0 = charge from the first one)
# MCITY_SKILL=hacking                  # skill snapshotted after every batch (journal, status push, report)
# MCITY_PROGRESS_EVERY_MIN=60          # while working: deliver accepted contracts / check the tool goal every N min, not only after a batch
# MCITY_TOOL_GOAL=cinder_decoder       # tool mission: bought ONCE from its vendor when the skill reaches the required level ("" = off)
# MCITY_INITIATE_COOLDOWN_MIN=5
# MCITY_MAX_INITIATES=40
# MCITY_SAME_AGENT_COOLDOWN_H=3
# MCITY_INITIATE_BELOW=16

# ---- daily report by mail / push (optional) ----
# MCITY_REPORT_EMAIL_TO=you@example.com
# SMTP_URL=smtps://user:url-encoded-password@smtp.example.com:465
# MCITY_REPORT_WEBHOOK=https://ntfy.sh/your-topic

# ---- NIGHTGATE: real proofs on Midnight (optional; everything is a no-op without these) ----
# The agent anchors its daily report, batches, conversations and explorations
# on the Midnight chain and makes zero-knowledge claims about its numbers.
# See README.md for the full story.
NIGHTGATE_ATTEST=1
NIGHTGATE_BASE_URL=https://api.nightgate.dev
NIGHTGATE_NETWORK=preprod
# The agent's own attester identity: a fresh 64-byte seed (128 hex chars).
# It needs NO funds - the sponsor pays the dust. Generate one:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
NIGHTGATE_SEED_HEX=128_hex_chars_here
# Agent-grant token from the NIGHTGATE operator (scoped: sponsorUnboundTransaction
# plus the always-allowed compute/read actions, daily job budget, revocable)
NIGHTGATE_TOKEN=ngat_your_grant_token
# The sponsor session the grant is pinned to (a pinned grant refuses the pool sentinel)
NIGHTGATE_SPONSOR_SESSION_ID=00000000-0000-0000-0000-000000000000
# AttestationVault deployment to anchor against (must be allow-listed on the sponsor)
NIGHTGATE_VAULT=9b97a6764805789852351a401b7cfc137097d591cabe33926dfbc42792c00137
NIGHTGATE_VAULT_ARTIFACT=attestation-vault-32
# NIGHTGATE_MAX_ANCHORS_PER_DAY=60
# NIGHTGATE_PROOF_SERVER_URL=           # prove on a proof server instead of in-process wasm
# NIGHTGATE_VISIBILITY_WAIT_MS=120000   # max wait for the previous tx to show up in the indexer before the next build
# NIGHTGATE_LATE_LAND_WAIT_MS=180000    # after a sponsor "submit watch timed out": keep probing the indexer this long for a late landing (0 = off)
# NIGHTGATE_BATCH_MAX=1                 # >1: bundle consecutive plain attests into one transaction (max 8)
