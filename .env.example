# ---- Midnight City observer (required) ----
MCITY_OBSERVER_URL=https://midnight.city/observer
MCITY_API_TOKEN=midnight_your_user_api_key
# Optional: skip the `claimable` lookup and pin the agent id
# MCITY_AGENT_ID=user-agent-...

# ---- LLM for conversations (optional; rule engine works without it) ----
# CLAUDE_API_KEY=sk-ant-...            # alias for ANTHROPIC_API_KEY
# ANTHROPIC_WORKSPACE_ID=wrkspc_...    # only for identity-linked keys
# MCITY_LLM_MODEL=claude-sonnet-5
# MCITY_LLM_DAILY_BUDGET_USD=2.50

# ---- daily rhythm (optional) ----
# MCITY_SLEEP_START=01:00
# MCITY_SLEEP_END=06:30
# MCITY_REPORT_TIME=08:00
# MCITY_STATUS_EVERY_HOURS=3
# MCITY_WEIGHTS=work:50,social:30,explore:20
# MCITY_INITIATE_COOLDOWN_MIN=5
# MCITY_MAX_INITIATES=40
# MCITY_SAME_AGENT_COOLDOWN_H=3
# MCITY_INITIATE_BELOW=16

# ---- daily report by mail / push (optional) ----
# MCITY_REPORT_EMAIL_TO=you@example.com
# SMTP_URL=smtps://user:url-encoded-password@smtp.example.com:465
# MCITY_REPORT_WEBHOOK=https://ntfy.sh/your-topic

# ---- NIGHTGATE: real proofs on Midnight (optional; everything is a no-op without these) ----
# The agent anchors its daily report, batches, conversations and explorations
# on the Midnight chain and makes zero-knowledge claims about its numbers.
# See README.md for the full story.
NIGHTGATE_ATTEST=1
NIGHTGATE_BASE_URL=https://api.nightgate.dev
NIGHTGATE_NETWORK=preprod
# The agent's own attester identity: a fresh 64-byte seed (128 hex chars).
# It needs NO funds - the sponsor pays the dust. Generate one:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
NIGHTGATE_SEED_HEX=128_hex_chars_here
# Agent-grant token from the NIGHTGATE operator (scoped: sponsorUnboundTransaction
# plus the always-allowed compute/read actions, daily job budget, revocable)
NIGHTGATE_TOKEN=ngat_your_grant_token
# The sponsor session the grant is pinned to (a pinned grant refuses the pool sentinel)
NIGHTGATE_SPONSOR_SESSION_ID=00000000-0000-0000-0000-000000000000
# AttestationVault deployment to anchor against (must be allow-listed on the sponsor)
NIGHTGATE_VAULT=9b97a6764805789852351a401b7cfc137097d591cabe33926dfbc42792c00137
NIGHTGATE_VAULT_ARTIFACT=attestation-vault-32
# NIGHTGATE_MAX_ANCHORS_PER_DAY=60
# NIGHTGATE_PROOF_SERVER_URL=           # prove on a proof server instead of in-process wasm
