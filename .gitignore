# secrets & local operator notes
.env
# every .env copy (backups like .env.bak-pre-v4-*) holds the same secrets; only the template is public
.env.*
!.env.example
OPERATIONS.local.md
CLAUDE.md

# runtime state (agent memory, attestation log, doc-proof witnesses, prediction nonces)
data/
reports/
scripts/.responder-memory.json

# logs from live runs (contain in-game conversations)
*.log

# local scratch & one-shot ops scripts (not needed to run the agent)
