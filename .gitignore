#   tarball packs them from the working tree, git does not need them
docproof-sample.json
image.png
scripts/deploy-vault.mjs
scripts/backfill-txhash.mjs
scripts/run-forever.cmd
scripts/*.sh
vendor/

node_modules/
docs/bug-*.md
